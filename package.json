{
  "name": "smartsupply-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run --prefix apps/web dev",
    "build": "npm run --prefix apps/web build",
    "start": "npm run --prefix apps/web start",
    "lint": "npm run --prefix apps/web lint",
    "test": "node --test tests/*.test.mjs && npm test --prefix services/inventory-service",
    "test:web": "node --test tests/*.test.mjs",
    "test:services": "npm test --prefix services/inventory-service"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.0"
  }
}
